# Starts the Incident stack at boot. Installed by deploy/user-data.sh.
# Deliberately no Docker restart policies: a crash injected with /chaos must stay down
# until someone restarts the service, exactly like locally.
[Unit]
Description=Incident stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/incident
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
