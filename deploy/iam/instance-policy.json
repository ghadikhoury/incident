{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackendIncidentUpdates",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage"],
      "Resource": "arn:aws:sqs:us-east-2:ACCOUNT_ID:incident-updates"
    },
    {
      "Sid": "BackendIncidentTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:ConditionCheckItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-2:ACCOUNT_ID:table/incident-store",
        "arn:aws:dynamodb:us-east-2:ACCOUNT_ID:table/incident-store/index/*"
      ]
    },
    {
      "Sid": "DockerShipsContainerLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:us-east-2:ACCOUNT_ID:log-group:/incident/*",
        "arn:aws:logs:us-east-2:ACCOUNT_ID:log-group:/incident/*:log-stream:*"
      ]
    }
  ]
}
