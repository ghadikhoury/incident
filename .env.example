# Copy to .env and fill in. Never commit .env.
AWS_REGION=us-east-2
AWS_PROFILE=incident

# Diagnosis provider (Gemini uses only synthetic evidence)
DIAGNOSIS_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0
# Local health detection and isolated SQLite storage. EC2 override selects aws.
INCIDENT_MODE=local
